# VOTEX Contracts Deployment Environment Template
#
# Copy this file to `.env` in `votex/contracts/` to configure Ethereum Sepolia deployment.
# NEVER commit your `.env` or real private keys to version control.
# NEVER share or paste your private key into any chat or public forum.

# --- Ethereum Sepolia Network (Chain ID: 11155111) ---
# Dedicated Sepolia RPC Endpoint (e.g. Infura, Alchemy, QuickNode, or public RPC)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Dedicated Testnet Deployer Private Key
# MUST be a dedicated testnet wallet funded with Sepolia test ETH (e.g. from Google Cloud or Sepolia faucet).
# DO NOT USE A MAINNET ACCOUNT OR A WALLET CONTAINING REAL VALUE.
# Format: 64 hex characters (with or without '0x' prefix)
SEPOLIA_PRIVATE_KEY=your_sepolia_private_key_here
