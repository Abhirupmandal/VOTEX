# VOTEX local environment template.
#
# Copy to `.env` and adjust as needed. Never commit real secrets.
# Consumed by docker-compose.yml.

# --- PostgreSQL ---
POSTGRES_USER=votex
POSTGRES_PASSWORD=votex
POSTGRES_DB=votex
POSTGRES_PORT=5432

# --- Backend ---
ENVIRONMENT=development
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg2://votex:votex@localhost:5432/votex

# --- Blockchain ---
# 31337 for Hardhat local, 11155111 for Ethereum Sepolia
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# BLOCKCHAIN_CHAIN_ID=11155111
# BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# --- Trusted contract addresses (from scripts/deploy.ts) ---
VOTEX_FACTORY_ADDRESS=
VOTER_REGISTRY_ADDRESS=
EMERGENCY_CONTROLLER_ADDRESS=
VOTEX_ACCESS_MANAGER_ADDRESS=

# --- Indexer ---
INDEXER_ENABLED=false
# On Sepolia testnet, set to deployment block of factory to prevent historical scan from 0:
INDEXER_START_BLOCK=0
INDEXER_POLL_INTERVAL=2.0
INDEXER_CONFIRMATIONS=0
INDEXER_REORG_REWIND=10
INDEXER_NETWORK=local
# For Sepolia indexing:
# INDEXER_NETWORK=sepolia
