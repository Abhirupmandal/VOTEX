# VOTEX backend environment template.
#
# Copy to `.env` for local (non-Docker) development. Never commit secrets.
# Phase 3 adds blockchain connectivity, contract addresses, and indexer tuning.

# --- Service ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Database --------------------------------------------------------------
# SQLAlchemy URL for local PostgreSQL.
DATABASE_URL=postgresql+psycopg2://votex:votex@localhost:5432/votex

# --- Blockchain ------------------------------------------------------------
# Both the BLOCKCHAIN_* namespaced names and the legacy RPC_URL/CHAIN_ID names
# are accepted. Prefer the namespaced forms.
#
# Local Hardhat Node (Chain ID 31337):
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
#
# Ethereum Sepolia Testnet (Chain ID 11155111):
# BLOCKCHAIN_CHAIN_ID=11155111
# BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
#
# Legacy aliases (still honoured):
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# --- Trusted contract addresses -------------------------------------------
# Filled in after deployment (e.g. from contracts/deployments/sepolia.json).
# These are read from configuration ONLY, never from an API request.
# Local defaults:
VOTEX_FACTORY_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
VOTER_REGISTRY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
EMERGENCY_CONTROLLER_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
VOTEX_ACCESS_MANAGER_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
#
# Ethereum Sepolia Deployed Addresses (Phase 7):
# VOTEX_FACTORY_ADDRESS=0x27B6CBfCF0E909e2e4158A34b42e2904041312Be
# VOTER_REGISTRY_ADDRESS=0x3C2482EdA3aaDa7EEeb07c937f1c2DAF7fedCeEc
# EMERGENCY_CONTROLLER_ADDRESS=0x6a381FCe8494c09D131d0F0467e83150801Ec526
# VOTEX_ACCESS_MANAGER_ADDRESS=0x32CcA7F2A1336e9160e2c1D76F9C3493C0f6F033

# Directory holding compiled Hardhat artifacts (ABIs). Defaults to
# <repo>/votex/contracts/artifacts when left unset.
# CONTRACTS_ARTIFACTS_DIR=

# --- Indexer ---------------------------------------------------------------
INDEXER_ENABLED=false
# IMPORTANT FOR TESTNET: On Sepolia, set INDEXER_START_BLOCK to the deployment block (11938337)
# of ElectionFactory (found in deployments/sepolia.json) to avoid scanning millions of historical blocks.
INDEXER_START_BLOCK=0
# Safeguard: Block 0 is strictly refused on Sepolia unless explicitly permitted:
INDEXER_ALLOW_UNSAFE_ZERO_START_BLOCK=false
INDEXER_BATCH_SIZE=2000
INDEXER_POLL_INTERVAL=2.0
# Blocks kept behind the head to reduce reorg exposure (0 for local, 2 recommended for Sepolia).
INDEXER_CONFIRMATIONS=0
# For Sepolia indexer:
# INDEXER_CONFIRMATIONS=2
# How far to rewind when a block-hash discontinuity is detected.
INDEXER_REORG_REWIND=10
# Network identifier for state tracking ("local" or "sepolia").
INDEXER_NETWORK=local
# For Sepolia: INDEXER_NETWORK=sepolia
# For Sepolia: INDEXER_START_BLOCK=11938337

# --- API -------------------------------------------------------------------
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20
