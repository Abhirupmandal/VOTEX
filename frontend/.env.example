# VOTEX Frontend Environment Template
#
# Copy to `.env.local` for local development. Never commit real private keys or secrets.
# In Next.js, NEXT_PUBLIC_* variables are inlined at build time.

# ==============================================================================
# NETWORK CONFIGURATION
# ==============================================================================

# Target Chain ID:
# 31337 = Hardhat Local Development Node
# 11155111 = Ethereum Sepolia Testnet
NEXT_PUBLIC_CHAIN_ID=31337

# Local RPC URL (Hardhat node default)
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Ethereum Sepolia RPC URL (Infura, Alchemy, or public RPC)
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# Sepolia Block Explorer (Etherscan default)
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io
NEXT_PUBLIC_SEPOLIA_EXPLORER_URL=https://sepolia.etherscan.io

# ==============================================================================
# BACKEND API CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# ==============================================================================
# CONTRACT ADDRESSES (Hardhat Local / Default)
# ==============================================================================
NEXT_PUBLIC_ELECTION_FACTORY_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
NEXT_PUBLIC_VOTER_REGISTRY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
NEXT_PUBLIC_EMERGENCY_CONTROLLER_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
NEXT_PUBLIC_ACCESS_MANAGER_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ==============================================================================
# CONTRACT ADDRESSES (Ethereum Sepolia Testnet - deployed in Phase 7)
# ==============================================================================
NEXT_PUBLIC_SEPOLIA_ELECTION_FACTORY_ADDRESS=0x27B6CBfCF0E909e2e4158A34b42e2904041312Be
NEXT_PUBLIC_SEPOLIA_VOTER_REGISTRY_ADDRESS=0x3C2482EdA3aaDa7EEeb07c937f1c2DAF7fedCeEc
NEXT_PUBLIC_SEPOLIA_EMERGENCY_CONTROLLER_ADDRESS=0x6a381FCe8494c09D131d0F0467e83150801Ec526
NEXT_PUBLIC_SEPOLIA_ACCESS_MANAGER_ADDRESS=0x32CcA7F2A1336e9160e2c1D76F9C3493C0f6F033
